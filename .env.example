# Email transport for /api/forms. Set ONE option.
# Option 1: the company mailbox over SMTP (Reinhost: use the mailbox's "Connect Devices" / mail client settings)
SMTP_HOST=              # e.g. mail.edgevervebs.org
SMTP_PORT=465           # 465 (SSL) or 587 (STARTTLS)
SMTP_USER=              # the full mailbox address, e.g. info@edgevervebs.org
SMTP_PASS=              # that mailbox's password. Never commit it; set it on the host only.
# Option 2 / 3: an email API
ZEPTO_TOKEN=            # "Zoho-enczapikey xxxx"
RESEND_API_KEY=         # "re_xxxx"
MAIL_FROM=               # leave empty with SMTP (sends from SMTP_USER)
MAIL_FROM_NAME=EBSL
TEAM_EMAIL=info@edgevervebs.org
HR_EMAIL=info@edgevervebs.org

# Newsletter (Brevo) — optional
BREVO_API_KEY=
BREVO_LIST_ID=

# Analytics — optional
NEXT_PUBLIC_GA_ID=
